    },
    {
      "id": "scenario_4_inventory_shortage",
      "description": "Stock for a product at a warehouse drops below its reorder point.",
      "event": "INVENTORY_SHORTAGE",
      "params": {},
      "expected_incident_type": "inventory_shortage"
    },
    {
      "id": "scenario_5_warehouse_unavailable",
      "description": "A warehouse goes offline, delaying every shipment scheduled into it.",
